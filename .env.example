# Copy this file to .env and adjust the values.
# .env is gitignored: never commit real credentials.

# --- Kafka (Part B) ---
# Bootstrap servers as seen from the HOST (this is what producer.py / consumer.py use)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Same contract for both scripts; change all of them together
KAFKA_TOPIC=happiness-events
KAFKA_KEY_SOURCE=country
KAFKA_CONSUMER_GROUP=happiness-ml-team
# Delay between events emitted by the producer, in seconds
PRODUCER_DELAY_SECONDS=1.0

# --- Project file paths (relative to the repo root) ---
# Linear model Pipeline trained in P5 and loaded by consumer.py
MODEL_PATH=models/model.pkl
# Data the producer streams for inference (created in P5)
STREAMING_DATA_PATH=data/streaming/test_split.csv

# --- MySQL (Parts B and C, used by docker-compose.yml and the consumer) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=happiness_db
MYSQL_USER=happiness_user
MYSQL_PASSWORD=change_me

# Used ONLY by docker-compose.yml to bootstrap MySQL
MYSQL_ROOT_PASSWORD=change_me_root
